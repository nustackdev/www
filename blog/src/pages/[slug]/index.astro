---
import { render } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import Base from '../../layouts/Base.astro';
import { Header, Body, Chapter } from '@www/shared/components/page';
import { Row } from '@www/shared/components/grid/Row';
import { Cell } from '@www/shared/components/grid/Cell';
import { CellContent } from '@www/shared/components/grid/CellContent';
import { blogPostingLd } from '@www/shared/lib/jsonld';
import { formatDate } from '@www/shared/lib/date';
import Comments from '../../components/Comments';
import { BLOG_TITLE, getPosts, ogImagePath, postPath, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, author, tags } = post.data;
const path = postPath(post);
const image = ogImagePath(post.id);
---

<Base
  title={title}
  docTitle={`${title} | ${BLOG_TITLE}`}
  description={description}
  path={path}
  image={image}
  imageAlt={title}
  article={{ date, author, tags }}
  jsonLd={[blogPostingLd({ title, description, url: path, image, date, author, tags })]}
>
  <Header title={title} lede={description}>
    <span slot="meta" class="meta-row">
      <a href="/blog/" class="back-link">
        <ArrowLeft size={12} aria-hidden="true" />
        <span>Blog</span>
      </a>
      <span class="sep">·</span>
      <time datetime={date}>{formatDate(date)}</time>
      <span class="sep">·</span>
      <span>by {author}</span>
    </span>
  </Header>
  <Body>
    <Chapter>
      <Row cols={1}>
        <Cell>
          <CellContent pad="lg">
            <article class="prose" data-pagefind-body>
              <Content />
            </article>
          </CellContent>
        </Cell>
      </Row>
    </Chapter>
    <Chapter>
      <Row cols={1}>
        <Cell>
          <CellContent pad="lg">
            <section class="comments" aria-label="Comments" data-pagefind-ignore>
              <Comments client:visible />
            </section>
          </CellContent>
        </Cell>
      </Row>
    </Chapter>
  </Body>
</Base>

<style>
  .meta-row {
    display: inline-flex;
    align-items: center;
    gap: var(--site-gap-tight);
    color: var(--site-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: inherit;
    text-decoration: none;
    transition: color var(--site-t);
  }
  .back-link :global(svg) {
    transition: transform 0.18s ease;
  }
  .back-link:hover,
  .back-link:focus-visible {
    color: var(--site-ink);
    outline: none;
  }
  .back-link:hover :global(svg),
  .back-link:focus-visible :global(svg) {
    transform: translateX(-2px);
  }
  .sep {
    opacity: 0.5;
  }
  .comments {
    max-width: 72ch;
    margin-inline: auto;
  }
</style>
