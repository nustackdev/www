---
import Base from '../layouts/Base.astro';
import { Heading, Lede } from '@www/shared/components/text';
import { MonoKicker } from '@www/shared/components/meta/MonoKicker';
import { formatDate } from '@www/shared/lib/date';
import { BLOG_DESCRIPTION, BLOG_TITLE, getPosts, ogImagePath, postPath } from '../lib/posts';

const posts = await getPosts();
---

<Base title={BLOG_TITLE} description={BLOG_DESCRIPTION} path="/blog/" image={ogImagePath('index')}>
  <div class="blog-column">
    <header class="head">
      <Heading level={1}>Blog</Heading>
      <Lede className="lede">{BLOG_DESCRIPTION}</Lede>
    </header>

    <ol class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={postPath(post)} class="post">
              <MonoKicker size="xs" tracking="wider">
                {formatDate(post.data.date)} · by {post.data.author}
                {post.data.draft ? ' · draft' : ''}
              </MonoKicker>
              <span class="title">{post.data.title}</span>
              <span class="desc">{post.data.description}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .head {
    padding-block: var(--site-gap-loose) var(--site-gap-xloose);
  }
  .head :global(.lede) {
    margin-top: var(--site-gap-normal);
    color: var(--site-ink-2);
  }
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--site-border);
  }
  .posts li {
    border-bottom: 1px solid var(--site-border);
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: var(--site-gap-loose);
    color: inherit;
    text-decoration: none;
  }
  .title {
    font-size: var(--site-fs-heading-2);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--site-ink);
    transition: color var(--site-t);
  }
  .desc {
    color: var(--site-ink-3);
    line-height: 1.6;
    max-width: 68ch;
  }
  .post:hover .title,
  .post:focus-visible .title {
    color: var(--site-accent);
  }
  .post:focus-visible {
    outline: none;
  }
</style>
